APP_NAME=MetaTank
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública real: se usa para construir los statusCallback que invoca Twilio
# y las URLs de los archivos multimedia de las campañas.
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_referido
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# En producción usar database o redis: con `sync` los envíos masivos se
# procesan en la misma petición y no se respeta el rate limiting.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Usuario administrador que crea DatabaseSeeder. Sin estas dos variables no se
# crea ningún admin (para no dejar credenciales de ejemplo en producción).
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="Administrador Principal"
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE="Administrador"

# ---------------------------------------------------------------------------
# Twilio (WhatsApp masivo con plantillas)
# ---------------------------------------------------------------------------
TWILIO_WHATSAPP_MODE=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Debe coincidir con el Status Callback configurado en la consola de Twilio
TWILIO_STATUS_CALLBACK_PATH=/api/twilio/whatsapp/status

# Solo poner en false para pruebas locales: sin validar la firma cualquiera
# puede inyectar respuestas falsas y disparar envíos con costo.
TWILIO_VERIFY_WEBHOOK_SIGNATURE=true

# ---------------------------------------------------------------------------
# Retell (resultados de llamadas)
# ---------------------------------------------------------------------------
RETELL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Worker externo de WhatsApp (endpoints /api/whatsapp/pull y /report)
# ---------------------------------------------------------------------------
WHATSAPP_WORKER_TOKEN=
WHATSAPP_RESERVE_SECONDS=180
WHATSAPP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# WPPConnect (WhatsApp sin Twilio). Sin BASE_URL y TOKEN la pila no funciona.
# ---------------------------------------------------------------------------
WPPCONNECT_BASE_URL=
WPPCONNECT_TOKEN=
WPPCONNECT_DEFAULT_SESSION=default
WPPCONNECT_DELAY_MIN_SECONDS=10
WPPCONNECT_DELAY_MAX_SECONDS=25
WPPCONNECT_CAMPAIGN_IMAGE_URL=
